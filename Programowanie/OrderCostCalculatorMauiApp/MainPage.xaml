<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OrderCostCalculatorMauiApp.MainPage"
             x:Name="thisPage"
             BindingContext="{x:Reference thisPage}">

    <StackLayout Orientation="Vertical"
                 Padding="20"
                 Spacing="10">

        <Entry
            x:Name="ProductEntry"
            Placeholder="Nazwa produktu" />

        <Entry
            x:Name="PriceEntry"
            Placeholder="Cena produktu"/>

        <Stepper
            Maximum="10"
            Minimum="1"
            Value="{Binding StepperValue}" />

        <Label Text="Liczba sztuk" />

        <Label
            Text="{Binding StepperValue}"
            FontSize="20"
            TextColor="Black"/>

        <HorizontalStackLayout>
            <Label
                Text="Dostawa ekspresowa"
                VerticalOptions="Center" />

            <Switch
                IsToggled="{Binding IsOn}" />
        </HorizontalStackLayout>

        <Button
            Command="{Binding Oblicz}"
            Text="Oblicz" />

        <Label
            Text="{Binding Result}"
            FontSize="18"
            FontAttributes="Bold" />

    </StackLayout>

</ContentPage>
